// W1: users, auth, ledger, economy params.
// W2: tables, rounds, bets, payouts, user stats.
// W4: payments, products, subscriptions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  COINS
  GEMS
}

enum AuthProvider {
  TELEGRAM
  GOOGLE
  EMAIL
}

enum LedgerType {
  WELCOME
  DAILY_CHECKIN
  TIMED_SUPPLY
  RELIEF
  REFERRAL
  BET
  BET_CANCEL
  PAYOUT
  REFUND
  PURCHASE
  VIP_DAILY
  ADMIN_ADJUST
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  nickname  String
  avatarUrl String?   @map("avatar_url")
  locale    String    @default("zh-Hant")
  isVip     Boolean   @default(false) @map("is_vip")
  vipExpiresAt DateTime? @map("vip_expires_at")
  frozenAt  DateTime? @map("frozen_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  identities    AuthIdentity[]
  refreshTokens RefreshToken[]
  balances      Balance[]
  ledgerEntries LedgerEntry[]
  bets          Bet[]
  payouts       RoundPayout[]
  stats         UserStats?
  rewards       UserRewards?
  payments      Payment[]

  @@map("users")
}

model AuthIdentity {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  provider    AuthProvider
  providerUid String       @map("provider_uid")
  email       String?
  meta        Json?
  createdAt   DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
  @@index([email])
  @@map("auth_identities")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model MagicLink {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("magic_links")
}

/// Cached balance. Invariant: amount == SUM(ledger_entries.amount) for (user, currency).
model Balance {
  userId    String   @map("user_id") @db.Uuid
  currency  Currency
  amount    BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, currency])
  @@map("balances")
}

/// Append-only. Every coin / gem movement goes through here. Never update or delete rows.
model LedgerEntry {
  id             BigInt     @id @default(autoincrement())
  userId         String     @map("user_id") @db.Uuid
  currency       Currency
  amount         BigInt
  type           LedgerType
  refType        String?    @map("ref_type")
  refId          String?    @map("ref_id")
  balanceAfter   BigInt     @map("balance_after")
  idempotencyKey String     @unique @map("idempotency_key")
  meta           Json?
  createdAt      DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([refType, refId])
  @@map("ledger_entries")
}

/// Hot-reloadable economy parameters. Key names follow TECH_DESIGN.md §13.1.
model EconomyParam {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("economy_params")
}

// ---------------------------------------------------------------------------
// W2: round engine
// ---------------------------------------------------------------------------

enum RoundStatus {
  SCHEDULED
  BETTING
  LOCKED
  SETTLED
  VOIDED
}

enum Side {
  BANKER
  PLAYER
}

model GameTable {
  id           String   @id
  symbol       String
  roundSeconds Int      @default(300) @map("round_seconds")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  rounds Round[]

  @@map("tables")
}

/// One 5-minute round. Timeline: bet_start_at → lock_at (price snapshot) → close_at (settle).
model Round {
  id            String      @id @default(uuid()) @db.Uuid
  tableId       String      @map("table_id")
  roundNo       BigInt      @map("round_no")
  status        RoundStatus
  betStartAt    DateTime    @map("bet_start_at")
  lockAt        DateTime    @map("lock_at")
  closeAt       DateTime    @map("close_at")
  lockPrice     Decimal?    @map("lock_price") @db.Decimal(18, 2)
  closePrice    Decimal?    @map("close_price") @db.Decimal(18, 2)
  priceSource   String?     @map("price_source")
  lockedAt      DateTime?   @map("locked_at")
  settledAt     DateTime?   @map("settled_at")
  poolBanker    BigInt      @default(0) @map("pool_banker")
  poolPlayer    BigInt      @default(0) @map("pool_player")
  fee           BigInt?
  winner        Side?
  payoutPerUnit Decimal?    @map("payout_per_unit") @db.Decimal(12, 6)
  destroyed     BigInt?
  voidReason    String?     @map("void_reason")
  createdAt     DateTime    @default(now()) @map("created_at")

  table   GameTable     @relation(fields: [tableId], references: [id])
  bets    Bet[]
  payouts RoundPayout[]

  @@unique([tableId, roundNo])
  @@index([tableId, status])
  @@index([tableId, closeAt(sort: Desc)])
  @@map("rounds")
}

model Bet {
  id             String    @id @default(uuid()) @db.Uuid
  roundId        String    @map("round_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  side           Side
  amount         BigInt
  cancelledAt    DateTime? @map("cancelled_at")
  idempotencyKey String    @unique @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")

  round Round @relation(fields: [roundId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([roundId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("bets")
}

model RoundPayout {
  roundId     String   @map("round_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  side        Side
  stake       BigInt
  payout      BigInt
  streakBonus BigInt   @default(0) @map("streak_bonus")
  createdAt   DateTime @default(now()) @map("created_at")

  round Round @relation(fields: [roundId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@id([roundId, userId])
  @@index([userId])
  @@map("round_payouts")
}

model UserStats {
  userId        String   @id @map("user_id") @db.Uuid
  totalRounds   Int      @default(0) @map("total_rounds")
  wins          Int      @default(0)
  currentStreak Int      @default(0) @map("current_streak")
  maxStreak     Int      @default(0) @map("max_streak")
  netProfit     BigInt   @default(0) @map("net_profit")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

// ---------------------------------------------------------------------------
// W5: leaderboards, admin
// ---------------------------------------------------------------------------

/// Per-user per-day (UTC+8 "YYYY-MM-DD") play aggregates, written in the settlement transaction.
/// Day / week / season leaderboards are sums over this table.
model UserStatsDaily {
  userId    String   @map("user_id") @db.Uuid
  day       String
  rounds    Int      @default(0)
  wins      Int      @default(0)
  staked    BigInt   @default(0)
  netProfit BigInt   @default(0) @map("net_profit")
  /// Best streak reached during this day.
  maxStreak Int      @default(0) @map("max_streak")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, day])
  @@index([day])
  @@map("user_stats_daily")
}

/// Audit log for every ops-console action.
model AdminAction {
  id          BigInt   @id @default(autoincrement())
  adminUserId String   @map("admin_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("admin_actions")
}

// ---------------------------------------------------------------------------
// W4: free rewards, shop, payments
// ---------------------------------------------------------------------------

/// Per-user reward bookkeeping. Dates are calendar days in UTC+8 ("YYYY-MM-DD").
model UserRewards {
  userId          String    @id @map("user_id") @db.Uuid
  /// Consecutive check-in days already claimed (0–7). Resets when a day is skipped.
  checkinStreak   Int       @default(0) @map("checkin_streak")
  lastCheckinDay  String?   @map("last_checkin_day")
  /// Energy-style regen anchor: charges = min(max, floor((now − anchor) / interval)).
  supplyAnchorAt  DateTime  @default(now()) @map("supply_anchor_at")
  lastReliefDay   String?   @map("last_relief_day")
  lastVipDailyDay String?   @map("last_vip_daily_day")
  firstChargeAt   DateTime? @map("first_charge_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_rewards")
}

enum ProductType {
  COINS
  GEMS
  VIP
}

/// Shop catalogue. Prices in USDT; Stars price stored explicitly (Telegram requires integers).
model Product {
  id         String      @id
  type       ProductType
  name       String
  priceUsdt  Decimal     @map("price_usdt") @db.Decimal(10, 2)
  priceStars Int         @map("price_stars")
  coins      BigInt      @default(0)
  gems       Int         @default(0)
  bonusPct   Int         @default(0) @map("bonus_pct")
  vipDays    Int         @default(0) @map("vip_days")
  sortOrder  Int         @default(0) @map("sort_order")
  enabled    Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  payments Payment[]

  @@map("products")
}

enum PaymentProvider {
  NOWPAYMENTS
  STRIPE
  TELEGRAM_STARS
  /// Non-production only: instant success for testing the crediting flow.
  DEV
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  EXPIRED
  FAILED
  REFUNDED
}

/// One purchase attempt. Crediting is idempotent on (provider, provider_order_id).
model Payment {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  productId       String          @map("product_id")
  provider        PaymentProvider
  providerOrderId String?         @map("provider_order_id")
  status          PaymentStatus   @default(PENDING)
  priceUsdt       Decimal         @map("price_usdt") @db.Decimal(10, 2)
  paidAmount      Decimal?        @map("paid_amount") @db.Decimal(18, 6)
  asset           String?
  chain           String?
  txHash          String?         @map("tx_hash")
  creditedCoins   BigInt          @default(0) @map("credited_coins")
  creditedGems    Int             @default(0) @map("credited_gems")
  firstCharge     Boolean         @default(false) @map("first_charge")
  payUrl          String?         @map("pay_url")
  meta            Json?
  createdAt       DateTime        @default(now()) @map("created_at")
  paidAt          DateTime?       @map("paid_at")
  expiresAt       DateTime?       @map("expires_at")

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([provider, providerOrderId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("payments")
}
