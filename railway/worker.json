{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm turbo run build --filter=@bpredict/worker..."
  },
  "deploy": {
    "startCommand": "pnpm --filter @bpredict/worker start",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
