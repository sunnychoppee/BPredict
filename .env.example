# Copy to .env and fill locally. Never commit real values.
# UAT/production: paste the same keys into Railway Variables.

NODE_ENV=development
APP_ENV=local

# --- apps/web ---
NEXT_PUBLIC_APP_ENV=local            # uat → TEST 水印
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3002
NEXT_PUBLIC_DEFAULT_LOCALE=zh-Hant
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=BacPredict_bot

# --- apps/api ---
API_PORT=3001
WEB_URL=http://localhost:3000
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bpredict
REDIS_URL=redis://localhost:6379

# Telegram BotFather (UAT bot; production bot is a separate token)
TELEGRAM_BOT_TOKEN=

# Google Cloud OAuth Web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Resend
RESEND_API_KEY=
RESEND_FROM=BPredict <noreply@example.com>

# Sentry (optional until W2)
SENTRY_DSN=

# --- payments: empty until W4 ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true
# NOWPayments has no sandbox anymore; a one-off live USDT test outside production needs this explicit override.
NOWPAYMENTS_ALLOW_LIVE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- admin console (W5): /admin in apps/web, API under apps/api/src/admin ---
# Comma-separated login emails (Google / email / dev-login "<nickname>@dev.local") allowed in.
# Empty = console disabled.
ADMIN_EMAILS=

# --- apps/ws ---
WS_PORT=3002

# --- apps/worker ---
WORKER_SCHEDULER=1                   # 0 = 只跑行情，不調度
# WORKER_INSTANCE_ID=                # 預設 pid+隨機，Railway 不用填
