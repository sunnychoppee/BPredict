{
  "name": "bpredict",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @bpredict/db generate",
    "db:migrate": "pnpm --filter @bpredict/db migrate:dev",
    "db:deploy": "pnpm --filter @bpredict/db migrate:deploy",
    "db:seed": "pnpm --filter @bpredict/db seed"
  },
  "devDependencies": {
    "railway": "^3.16.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
